{
  "name": "chronixd",
  "module": "src/index.ts",
  "type": "module",
  "version": "5.5.0",
  "scripts": {
    "main": "CACHE_DIR=$(pwd)/.cache DEBUG=1 bun run src/index.ts -- --output ./db",
    "preview": "bun run dist && CACHE_DIR=$(pwd)/.cache DEBUG=1 ./chronixd --output ./db",
    "dry-run": "CACHE_DIR=$(pwd)/.cache DEBUG=1 CHRONIXD_DRY_RUN=true bun run src/index.ts -- --output ./db",
    "ci:dry-run": "CACHE_DIR=$(pwd)/.cache CHRONIXD_DRY_RUN=true bun run src/index.ts -- --output ./db",
    "generate": "bun run src/index.ts -- generate --input ./db --output ./dist",
    "generate:dev": "bun run scripts/dev-server.ts",
    "generate:favicons": "bun run scripts/generate-favicon-data.ts",
    "dist": "bun build src/index.ts --compile --outfile chronixd",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "version:patch": "npx npm@latest version patch",
    "version:minor": "npx npm@latest version minor",
    "version:major": "npx npm@latest version major",
    "sync-version": "bash scripts/sync-version.sh",
    "postversion": "npm run sync-version && git commit -m 'chore: sync version' && git push --follow-tags"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "pagefind": "^1.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "typescript": "^5.5.0"
  },
  "imports": {
    "#jsx/jsx-runtime": "./src/generate/jsx/jsx-runtime.ts",
    "#jsx/jsx-dev-runtime": "./src/generate/jsx/jsx-dev-runtime.ts"
  },
  "packageManager": "bun@1.3.9",
  "optionalDependencies": {
    "@pagefind/darwin-arm64": "^1.3.0",
    "@pagefind/darwin-x64": "^1.3.0",
    "@pagefind/linux-arm64": "^1.3.0",
    "@pagefind/linux-x64": "^1.3.0"
  },
  "dependencies": {
    "@atproto/api": "^0.6.14",
    "@notionhq/client": "^5.9.0",
    "@octokit/graphql": "^7.0.1",
    "@octokit/graphql-schema": "^14.25.0",
    "@octokit/rest": "^20.0.1",
    "asocial-bookmark": "2.0.2",
    "ical-js-parser": "^0.7.4",
    "node-ical": "^0.16.1",
    "parse-github-event": "^1.1.5",
    "rss-parser": "^3.13.0"
  }
}
